{
  "name": "@moveeasy/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "STATIC_DIR=frontend/dist tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run && TEST_STORE=prisma vitest run",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "postinstall": "prisma generate && prisma generate --schema prisma/postgres/schema.prisma",
    "db:seed": "tsx src/db-cli.ts seed",
    "test:postgres": "TEST_STORE=prisma TEST_DATABASE=postgres vitest run"
  },
  "dependencies": {
    "@moveeasy/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "prisma": "6.19.3",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "@types/supertest": "6.0.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "supertest": "7.0.0",
    "vitest": "2.1.8",
    "yaml": "2.6.1"
  }
}
