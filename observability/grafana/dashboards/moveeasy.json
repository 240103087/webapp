        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=\"moveeasy\"} | deployment_environment_name=~\"$environment\" | service_version=~\"$version\" | severity_text=~\"ERROR|WARN\""
